@model inovayt.Models.Users

<form asp-action="User">
    <div class="card">
        <div class="card-header">
            AdvisorForms
        </div>
        <div class="card-body">


            <input type="hidden" id="hidevalue" value="0" />

            <img src="~/images/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: .8">

            <div class="row partialviewusers">
                <div class="col-md-12">
                    @Html.Partial("~/Views/Shared/_User.cshtml", Model.users)
                </div>
            </div>

            <div class="row partialviewasset">
                <div class="col-md-12">
                    @Html.Partial("~/Views/Shared/_Asset.cshtml",Model.assets)
                </div>
            </div>

            <div class="row">
                <div class="col-md-6" style="padding:10px;">
                </div>
                <div class="col-md-6" style="padding:10px;">
                    <label id="btn-next" class="btn btn-primary float-right" style="width:70px;margin-right:10px;">NEXT</label>
                    <input type="submit" class="btn btn-primary float-right" style="background-color:#7e7a7a; margin-right:10px;width:70px;" value="SAVE" />
                    <label id="btn-back" class="btn btn-primary float-right" style="margin-right:10px;">BACK</label>
                </div>
            </div>

            <div class="progress" style="margin-top:20px;">
                <div class="progress-bar progress-bar-info user-per"
                     role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="background-color:#428edf87;width:15%">
                    15%
                </div>
                <div class="progress-bar progress-bar-info asset-per"
                     role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="background-color:#428edf87;width:30%">
                    30%
                </div>
            </div>
        </div>
    </div>
</form>
<script src="~/js/custome/actions.js"></script>